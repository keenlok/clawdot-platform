  "cgroup_parent": "/system.slice/chatcore-release-build.slice",
  "resource_manifest": "/etc/chatcore-release-control/build-capabilities.json",
  "resource_limits": {
    "cpu_quota_micros": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "memory_bytes": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "memory_swap_bytes": "REPEAT_MEMORY_BYTES_EXACTLY",
