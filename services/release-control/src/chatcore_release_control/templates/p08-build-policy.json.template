  "buildkit_capabilities": "/etc/chatcore-release-control/build-capabilities.json",
  "fixed_builder": {
    "name": "chatcore-release-build",
    "container": "buildx_buildkit_chatcore-release-build0",
    "driver": "docker-container",
    "docker_context": "default",
    "docker_endpoint": "unix:///var/run/docker.sock",
