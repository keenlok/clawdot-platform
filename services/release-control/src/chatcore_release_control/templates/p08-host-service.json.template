{
  "version": 1,
  "target": "sb-bot",
  "policy_manifest_file": "/etc/chatcore-release-control/policy.json",
  "policy_digest": "REPLACE_WITH_REVIEWED_POLICY_SHA256",
  "broker_socket": "/run/chatcore-release-control/broker.sock",
  "broker_credential_file": "/etc/chatcore-release-control/host-broker.token",
  "host_socket": "/run/chatcore-release-control/host.sock",
  "journal_file": "/var/lib/chatcore-release-control/host-journal.json",
  "host_lock_file": "/var/lib/chatcore-release-control/host.lock",
  "repository_url": "https://github.com/OWNER/REPOSITORY.git",
  "git_path": "/usr/bin/git",
  "source_app_config_file": "/etc/chatcore-release-control/source-app.json",
  "source_scratch_directory": "/var/lib/chatcore-release-control/source",
  "docker_path": "/usr/bin/docker",
  "docker_config": "/var/lib/chatcore-release-control/docker",
  "compose_file": "/etc/chatcore-release-control/p08-runtime-compose.yml",
  "runtime_env_file": "/etc/chatcore-release-control/runtime-limits.env",
  "app_runtime_env_file": "/etc/chatcore-release-control/app-runtime.env",
  "runtime_config_manifest_file": "/etc/chatcore-release-control/runtime-config.json",
  "runtime_config_files": [
    "/etc/chatcore-release-control/app-runtime.env",
    "/etc/chatcore-release-control/p08-runtime-compose.yml",
    "/etc/chatcore-release-control/runtime-limits.env"
  ],
  "build_recipe": "/etc/chatcore-release-control/p08-app.Dockerfile",
  "build_entrypoint": "/etc/chatcore-release-control/p08-entrypoint.sh",
  "build_smoke_probe": "/etc/chatcore-release-control/p08-smoke.py",
  "dependency_cache": "/var/lib/chatcore-release-control/dependency-cache.tar",
  "dependency_cache_sha256": "REPLACE_WITH_REVIEWED_CACHE_SHA256",
  "build_resource_manifest": "/etc/chatcore-release-control/build-capabilities.json",
  "build_scratch_directory": "/var/lib/chatcore-release-control/build",
  "image_repository": "local/sb-bot",
  "reviewed_source_exceptions": ["apps/sb_bot/deploy/backup.sh"],
  "buildx_builder": "chatcore-release-build",
  "buildkit_container": "buildx_buildkit_chatcore-release-build0",
  "buildkit_image_ref": "REPLACE_WITH_PINNED_BUILDKIT_IMAGE_REF_AND_SHA256",
  "buildkit_image_id": "sha256:REPLACE_WITH_PINNED_BUILDKIT_IMAGE_ID",
  "allowed_paths": ["REPLACE_WITH_SORTED_REVIEWED_POLICY_PATHS"],
  "migration_path_prefixes": [
    "packages/core/src/chatcore/migrations",
    "packages/core/src/chatcore/store/migrations.py",
    "packages/plugins/browse/src/chatcore_browse/migrations",
    "packages/plugins/expenses/src/chatcore_expenses/migrations",
    "packages/plugins/extensions/src/chatcore_extensions/migrations",
    "packages/plugins/jobs/src/chatcore_jobs/migrations",
    "packages/plugins/memory/src/chatcore_memory/migrations",
    "packages/plugins/polls/src/chatcore_polls/migrations",
    "packages/plugins/research/src/chatcore_research/migrations",
    "packages/plugins/search/src/chatcore_search/migrations",
    "packages/plugins/stocks/src/chatcore_stocks/migrations",
    "packages/plugins/web/src/chatcore_web/migrations"
  ],
  "source_roots": ["apps/sb_bot", "packages"],
  "test_paths": ["apps/sb_bot/tests", "packages"],
  "worker_source": "/opt/chatcore-release-control/development_worker.py",
  "harness_source": "/opt/chatcore-release-control/monorepo_harness.py",
  "build_resource_limits": {
    "cpu_quota_micros": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "memory_bytes": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "pids_max": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "scratch_bytes": "REPLACE_AFTER_HOST_CAPACITY_MEASUREMENT",
    "timeout_seconds": 600,
    "max_output_bytes": 65536
  }
}
