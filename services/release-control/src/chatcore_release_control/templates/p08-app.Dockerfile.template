FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 /uv /uvx /bin/
WORKDIR /src
COPY baseline.tar /tmp/baseline.tar
COPY dependency-cache.tar /tmp/dependency-cache.tar
ARG DEPENDENCY_CACHE_SHA256
RUN test -n "${DEPENDENCY_CACHE_SHA256}" \
    && echo "${DEPENDENCY_CACHE_SHA256}  /tmp/dependency-cache.tar" | sha256sum -c - \
    && mkdir -p /root/.cache/uv \
    && tar -xf /tmp/dependency-cache.tar -C /root/.cache/uv \
    && tar -xf /tmp/baseline.tar -C /src \
    && UV_CACHE_DIR=/root/.cache/uv UV_PROJECT_ENVIRONMENT=/src/.venv \
       /bin/uv sync --offline --frozen --no-dev --package sb-bot --no-editable

FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS runtime
RUN groupadd --gid 10001 sbbot \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin sbbot
COPY --from=builder --chown=10001:10001 /src/.venv /app/.venv
COPY --chown=0:0 p08-entrypoint.sh /usr/local/bin/chatcore-entrypoint
COPY --chown=0:0 p08-smoke.py /usr/local/bin/chatcore-smoke
RUN chmod 0555 /usr/local/bin/chatcore-entrypoint /usr/local/bin/chatcore-smoke
ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    EMBED_CACHE_DIR=/models/embeddinggemma-300m \
    HOME=/tmp
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD ["python", "-I", "/usr/local/bin/chatcore-smoke"]
ENTRYPOINT ["/usr/local/bin/chatcore-entrypoint"]
CMD ["sb-bot", "--platform", "telegram"]
